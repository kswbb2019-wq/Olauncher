<?xml version="1.0" encoding="utf-8"?>
<!-- Add or edit a task: title, date, time and note -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="8dp"
    android:orientation="vertical">

    <EditText
        android:id="@+id/taskTitle"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/tasks_title"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/taskDate"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:padding="8dp"
            tools:text="16.11.2026" />

        <TextView
            android:id="@+id/taskTime"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:padding="8dp"
            tools:text="@string/tasks_no_time" />

        <TextView
            android:id="@+id/taskTimeClear"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/tasks_no_time"
            android:focusable="true"
            android:padding="8dp"
            android:text="✕"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <EditText
        android:id="@+id/taskNote"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/tasks_note"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="4" />
</LinearLayout>
