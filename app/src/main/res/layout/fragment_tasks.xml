<?xml version="1.0" encoding="utf-8"?>
<!-- All tasks by date, filled in by TasksFragment. + adds one, a long press edits or deletes.
     Swiping left shows the same tasks as a month calendar, swiping right goes back -->
<app.olauncher.ui.SwipeLeftLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tasksRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    tools:context=".ui.TasksFragment">

    <ScrollView
        android:id="@+id/tasksScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="48dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tasksContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="112dp" />
    </ScrollView>

    <!-- MonthCalendarView in task mode, added by TasksFragment -->
    <FrameLayout
        android:id="@+id/tasksCalendar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="96dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tasksListTab"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/tasks_list_view" />

        <TextView
            android:id="@+id/tasksCalendarTab"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/tasks_calendar_view" />
    </LinearLayout>

    <TextView
        android:id="@+id/tasksAdd"
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tasks_add"
        android:focusable="true"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="+"
        tools:ignore="HardcodedText" />
</app.olauncher.ui.SwipeLeftLayout>
